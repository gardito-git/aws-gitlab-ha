# {{ ansible_managed }}
datacenter = "{{ consul_datacenter }}"
data_dir   = "/opt/consul"
node_name  = "{{ inventory_hostname }}"
bind_addr  = "{{ private_ip }}"
encrypt    = "{{ secrets.consul_gossip_key }}"

retry_join = [{% for host in groups['consul'] %}"{{ hostvars[host].private_ip }}"{{ ", " if not loop.last }}{% endfor %}]

{% if consul_server %}
server           = true
bootstrap_expect = {{ groups['consul'] | length }}
# Reachable from the VPN (UI) and the monitoring node (metrics); the security
# group decides who gets in.
client_addr = "0.0.0.0"

ui_config {
  enabled = true
}
{% else %}
server      = false
client_addr = "127.0.0.1" # only the local Patroni uses this agent
{% endif %}

telemetry {
  prometheus_retention_time = "60s"
  disable_hostname          = true
}
